<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Warnings">

        <CheckBoxPreference
            android:defaultValue="true"
            android:key="speed_warning"
            android:title="Enable Speed Warning" />
        <ListPreference
            android:defaultValue="180"
            android:entries="@array/speed_warning_text"
            android:entryValues="@array/speed_warning_value"
            android:key="speed_warning_list"
            android:title="Speed Warning Value" />

        <CheckBoxPreference
            android:defaultValue="false"
            android:key="lean_warning"
            android:title="Enable Lean Warning" />
        <ListPreference
            android:defaultValue="40"
            android:entries="@array/lean_warning_text"
            android:entryValues="@array/lean_warning_value"
            android:key="lean_warning_list"
            android:title="Lean Warning Value" />


    </PreferenceCategory>

    <PreferenceCategory android:title="Polling Rate">
        <ListPreference
            android:defaultValue="750"
            android:entries="@array/polling_rates"
            android:entryValues="@array/polling_rates"
            android:key="polling_rate"
            android:title="GPS Polling Rate" />
    </PreferenceCategory>

</PreferenceScreen>