<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/tracking">
        <ListPreference
            android:defaultValue="750"
            android:entries="@array/polling_rates_text"
            android:entryValues="@array/polling_rates"
            android:key="gps_polling_rate"
            android:title="@string/gps_polling_rate" />

        <CheckBoxPreference
            android:defaultValue="true"
            android:key="lean_track_enabled"
            android:title="@string/track_lean_angle" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/fuel_stations">
        <CheckBoxPreference
            android:defaultValue="true"
            android:key="show_fuel_stations"
            android:title="@string/show_fuel_stations" />

        <ListPreference
            android:defaultValue="2000"
            android:entries="@array/fuel_stations_range_text"
            android:entryValues="@array/fuel_stations_range_value"
            android:key="fuel_stations_range"
            android:title="@string/fuel_station_range" />

        <ListPreference
            android:defaultValue="10"
            android:entries="@array/fuel_stations_number_text"
            android:entryValues="@array/fuel_stations_number_value"
            android:key="fuel_stations_number"
            android:title="@string/number_of_fuel_stations" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/warnings">

        <CheckBoxPreference
            android:defaultValue="true"
            android:key="show_speed_warning"
            android:title="@string/show_speed_warning" />

        <CheckBoxPreference
            android:defaultValue="false"
            android:key="show_lean_warning"
            android:title="@string/show_lean_warning" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/warnings_thresholds">
        <ListPreference
            android:defaultValue="160"
            android:entries="@array/speed_warning_text"
            android:entryValues="@array/speed_warning_value"
            android:key="speed_warning"
            android:title="@string/speed_warning_threshold" />

        <ListPreference
            android:defaultValue="30"
            android:entries="@array/lean_warning_text"
            android:entryValues="@array/lean_warning_value"
            android:key="lean_warning"
            android:title="@string/lean_warning_threshold" />

    </PreferenceCategory>

</PreferenceScreen>